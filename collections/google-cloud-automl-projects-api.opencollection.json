            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://automl.googleapis.com/v1/projects/:projectId/locations/:location/datasets",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path"
              },
              {
                "name": "location",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Lists all datasets in the specified project and location."
        },
